{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "updatedAt": "2026-10-24",
  "refreshAfterDays": 90,
  "purpose": "Desempatar automaticamente skills instaladas igualmente adequadas sem substituir gatilhos obrigatorios, instrucoes locais ou especializacao tecnica.",
  "selectionOrder": [
    "higher_priority_instructions_and_explicit_user_skill",
    "task_relevance",
    "repository_and_stack_specificity",
    "safety_and_verification_requirements",
    "github_stars_tiebreaker"
  ],
  "rules": {
    "minimumSufficientSet": true,
    "compareStarsOnlyWithinSameCapability": true,
    "projectMandatorySkills": false,
    "runtimeRequiredTriggersStillApply": true,
    "projectLocalContextWinsWhenIndispensable": true,
    "unavailableSkillFallsBackToCompatibleAlternative": true,
    "unknownUpstreamIsNotZeroStars": true,
    "doNotBrowseOnEveryTask": true
  },
  "upstreams": [
